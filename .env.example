## Google Ads conversion tracking
# Example:
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=AW-1234567890
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=AbCdEfGhIjKlMnOpQrSt
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend (Email Service)
RESEND_API_KEY=your-resend-api-key

# Twilio (SMS - AI Tier)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Anthropic Claude API (AI Features)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google OAuth (GBP connect + login with Google)
# Client ID is public (browser). Secret is server-only (token exchange).
# If you only set NEXT_PUBLIC_* for the ID, the server will fall back to it for token exchange.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin
ADMIN_EMAIL=your-admin-email

# Stripe (Pro checkout + webhooks)
# Use test keys in .env.local; live keys in Vercel production. Keys and price IDs must be from the same Stripe mode (test vs live).
STRIPE_SECRET_KEY=
# Webhook signing secret from Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=
# Pro recurring Price IDs: Dashboard → Product catalog → Pro product → copy Price ID (starts with price_)
# Monthly must be exactly $29.00 USD (interval=month, interval_count=1).
STRIPE_PRO_MONTHLY_PRICE_ID=
# Annual must be exactly $290.00 USD (interval=year, interval_count=1).
STRIPE_PRO_ANNUAL_PRICE_ID=
# Reserved for the future AI tier checkout (not wired up yet — AI stays waitlist/Coming soon).
STRIPE_AI_MONTHLY_PRICE_ID=
# Legacy Pro price env var, kept only for grandfathered subscriptions created before the
# monthly/annual split. Never read by checkout — do not add a fallback to it.
# STRIPE_PRO_PRICE_ID=
# Optional: one-time early access product price
STRIPE_EARLY_ACCESS_PRICE_ID=
# Test-mode only: overrides the Stripe Checkout success/cancel redirect origin (e.g. localhost
# or a preview deployment). Ignored in production and for live secret keys — see
# lib/stripe-checkout-config.ts.
CHECKOUT_BASE_URL=

# Internal API secrets
# Used by /api/internal/morning-report-data to authenticate the scheduled morning report task.
# Generate with: openssl rand -hex 16
MORNING_REPORT_SECRET=your-morning-report-secret
